{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/instagram/webhook",
      "destination": "/api/instagram/webhook"
    },
    {
      "source": "/api/webhook/instagram",
      "destination": "/api/instagram/webhook"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
