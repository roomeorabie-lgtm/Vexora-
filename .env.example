# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Meta Graph API & Instagram Webhook Configuration
# 1. INSTAGRAM_VERIFY_TOKEN: The secret token you enter in Meta Developers -> Webhooks
INSTAGRAM_VERIFY_TOKEN="vexora_secure_webhook_token_2026"

# 2. META_APP_SECRET: From Meta App Dashboard -> App Settings -> Basic -> App Secret
# Used to verify incoming X-Hub-Signature-256 for maximum webhook security
META_APP_SECRET=""

# 3. META_ACCESS_TOKEN: System User or Page Long-Lived Token with instagram_manage_messages permission
META_ACCESS_TOKEN=""

# 4. INSTAGRAM_ACCOUNT_ID: Your Instagram Business / Professional Account ID
INSTAGRAM_ACCOUNT_ID=""

# 5. META_APP_ID: Your Meta App ID (from Meta Developer Console)
META_APP_ID=""

